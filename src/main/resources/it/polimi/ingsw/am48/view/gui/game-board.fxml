<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.geometry.Insets?>
<StackPane fx:id="rootboard" id="rootboard"
           stylesheets="@css/style.css, @css/boardStyle.css"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am48.view.gui.GameBoardController">
    <children>
        <BorderPane prefHeight="720.0" prefWidth="1280.0">

            <!-- BOTTOM: mano + sommario + token-->
            <bottom>
                <HBox alignment="CENTER_LEFT" spacing="50.0" BorderPane.alignment="CENTER" style="-fx-padding: 15;">
                    <children>
                        <ScrollPane fx:id="myHandBox"
                                    fitToHeight="true" fitToWidth="true"
                                    prefHeight="210.0" prefWidth="750.0"
                                    vbarPolicy="NEVER" hbarPolicy="NEVER"
                                    HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets left="100.0" />
                            </HBox.margin>
                        <content>
                            <!-- L'fx:id qui è la chiave di tutto! -->
                            <fx:include fx:id="playerTribe" source="player-tribe-screen.fxml" />
                        </content>
                        </ScrollPane>

                        <VBox fx:id="token" alignment="CENTER_LEFT"
                              prefHeight="210.0" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <ImageView fx:id="food" fitHeight="70.0" fitWidth="70.0"
                                               pickOnBounds="true" preserveRatio="true" styleClass="token">
                                        <image><Image url="@images/food.png"/></image>
                                    </ImageView>
                                    <Label fx:id="foodCount" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <ImageView fx:id="prestige_points" fitHeight="70.0" fitWidth="70.0"
                                               pickOnBounds="true" preserveRatio="true" styleClass="token">
                                        <image><Image url="@images/prestigePoints.png"/></image>
                                    </ImageView>
                                    <Label fx:id="prestigeCount" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="infoCard" alignment="CENTER"
                              prefHeight="210.0" spacing="12.0">
                            <HBox.margin>
                                <Insets right="100.0" />
                            </HBox.margin>
                            <children>
                                <ImageView fx:id="summary_card"
                                           fitHeight="170.0" fitWidth="200.0"
                                           pickOnBounds="true" preserveRatio="true">
                                    <image><Image url="@images/summary_card.png"/></image>
                                </ImageView>
                                <Button fx:id="bottone_avanti" mnemonicParsing="false"
                                        text="AVANTI" prefWidth="180.0" styleClass="button-menu-fire" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </bottom>
            <!--LEFT: avversario -->
            <left>
                <VBox fx:id="left_player" alignment="CENTER"
                      prefWidth="130.0" spacing="5.0" BorderPane.alignment="CENTER">
                    <ImageView fx:id="avatarLeft"
                               fitHeight="60.0" fitWidth="60.0"
                               pickOnBounds="true" preserveRatio="true"/>
                    <Label fx:id="labelLeft" text="Player 2" styleClass="opponent-label">
                        <font><Font name="System Bold" size="16.0"/></font>
                    </Label>
                </VBox>
            </left>

            <!-- RIGHT: avversario -->
            <right>
                <VBox fx:id="right_player" alignment="CENTER"
                      prefWidth="130.0" spacing="5.0" BorderPane.alignment="CENTER">
                    <ImageView fx:id="avatarRight"
                               fitHeight="60.0" fitWidth="60.0"
                               pickOnBounds="true" preserveRatio="true"/>
                    <Label fx:id="labelRight" text="Player 4" styleClass="opponent-label">
                        <font><Font name="System Bold" size="16.0"/></font>
                    </Label>
                </VBox>
            </right>

            <!-- TOP: avversari -->
            <top>
                <HBox alignment="CENTER" prefHeight="120.0" spacing="50.0"
                      BorderPane.alignment="CENTER">
                    <VBox fx:id="topLeft_player" alignment="CENTER"
                          prefHeight="120.0" prefWidth="280.0" spacing="5.0">
                        <ImageView fx:id="avatarTopLeft"
                                   fitHeight="60.0" fitWidth="60.0"
                                   pickOnBounds="true" preserveRatio="true"/>
                        <Label fx:id="labelTopLeft" text="Player 3" styleClass="opponent-label">
                            <font><Font name="System Bold" size="16.0"/></font>
                        </Label>
                    </VBox>
                    <VBox fx:id="topRight_player" alignment="CENTER"
                          prefHeight="120.0" prefWidth="280.0" spacing="5.0">
                        <ImageView fx:id="avatarTopRight"
                                   fitHeight="60.0" fitWidth="60.0"
                                   pickOnBounds="true" preserveRatio="true"/>
                        <Label fx:id="labelTopRight" text="Player 5" styleClass="opponent-label">
                            <font><Font name="System Bold" size="16.0"/></font>
                        </Label>
                    </VBox>
                </HBox>
            </top>

            <!-- CENTER: board -->
            <center>
                <VBox fx:id="boardTable" alignment="CENTER" spacing="5.0"
                      BorderPane.alignment="CENTER" styleClass="glass-box">

                    <HBox fx:id="upper_row" alignment="CENTER" spacing="10.0"
                          prefHeight="130.0">
                        <!-- Carte personaggio/tribù superiori -->
                        <HBox fx:id="deckable_sup" alignment="CENTER_LEFT"
                              spacing="5.0" prefHeight="130.0" prefWidth="350.0"/>
                        <!-- Carte edificio superiori -->
                        <HBox fx:id="building_sup" alignment="CENTER_LEFT"
                              spacing="5.0" prefHeight="130.0" prefWidth="200.0"/>
                    </HBox>

                    <!-- Fila centrale: offer track + deck -->
                    <HBox fx:id="centerBoard" alignment="CENTER" spacing="4.0"
                          prefHeight="180.0">
                        <Pane fx:id="offerTurnCard"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <!-- Posizioni A–G offer track -->
                        <VBox fx:id="offerCardA" alignment="CENTER"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <VBox fx:id="offerCardB" alignment="CENTER"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <VBox fx:id="offerCardC" alignment="CENTER"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <VBox fx:id="offerCardD" alignment="CENTER"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <VBox fx:id="offerCardE" alignment="CENTER"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <VBox fx:id="offerCardF" alignment="CENTER"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <VBox fx:id="offerCardG" alignment="CENTER"
                              prefHeight="180.0" prefWidth="95.0"/>
                        <VBox fx:id="deck" alignment="CENTER"
                              prefHeight="180.0" prefWidth="80.0"/>
                    </HBox>

                    <HBox fx:id="lower_row" alignment="CENTER" spacing="10.0"
                          prefHeight="130.0">
                        <HBox fx:id="deckable_inf" alignment="CENTER_LEFT"
                              spacing="5.0" prefHeight="130.0" prefWidth="350.0"/>
                        <HBox fx:id="building_inf" alignment="CENTER_LEFT"
                              spacing="5.0" prefHeight="130.0" prefWidth="200.0"/>
                    </HBox>

                </VBox>
            </center>

        </BorderPane>
    </children>
</StackPane>
