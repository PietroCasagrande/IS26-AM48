<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>

<!-- Questo VBox è il pannello "Glass Box" centrale -->
<VBox fx:id="boardCenterRoot" alignment="CENTER" spacing="15.0" styleClass="glass-box"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.am48.view.gui.BoardCenterController">

    <!-- RIGA SUPERIORE: Carte in offerta (Personaggi + Edifici) -->
    <HBox alignment="CENTER" spacing="20.0" prefHeight="130.0">
        <!-- Contenitore per le carte personaggio/tribù superiori -->
        <HBox fx:id="upperCharacterRow" alignment="CENTER_LEFT" spacing="5.0" prefWidth="350.0" />
        <!-- Contenitore per gli edifici superiori -->
        <HBox fx:id="upperBuildingRow" alignment="CENTER_LEFT" spacing="5.0" prefWidth="200.0" />
    </HBox>

    <!-- RIGA CENTRALE: Turn Card, Offer Track (A-G) e Deck -->
    <HBox alignment="CENTER" spacing="5.0" prefHeight="180.0">

        <!-- La carta che mostra l'ordine di turno -->
        <Pane fx:id="offerTurnCard" prefHeight="180.0" prefWidth="95.0" />

        <!-- Il contenitore MADRE delle 7 offer cards.
             Non mettiamo gli id per ogni slot, li riempiremo dinamicamente! -->
        <HBox fx:id="offerTrackContainer" alignment="CENTER" spacing="4.0" />

        <!-- Il mazzo (Deck) -->
        <VBox fx:id="deckContainer" alignment="CENTER" prefHeight="180.0" prefWidth="80.0" />

    </HBox>

    <!-- RIGA INFERIORE: Carte in offerta -->
    <HBox alignment="CENTER" spacing="20.0" prefHeight="130.0">
        <HBox fx:id="lowerCharacterRow" alignment="CENTER_LEFT" spacing="5.0" prefWidth="350.0" />
        <HBox fx:id="lowerBuildingRow" alignment="CENTER_LEFT" spacing="5.0" prefWidth="200.0" />
    </HBox>

</VBox>