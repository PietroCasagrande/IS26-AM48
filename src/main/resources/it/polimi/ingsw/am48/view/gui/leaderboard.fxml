<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootLeaderboard" prefHeight="720.0" prefWidth="1280.0"
           stylesheets="@css/boardStyle.css, @css/style.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am48.view.gui.LeaderboardController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="15.0" maxWidth="900.0">
            <StackPane.margin>
                <Insets top="40.0" />
            </StackPane.margin>
            <children>
                <Label fx:id="titleLabel" text="Leaderboard" styleClass="leaderboard-title">
                    <font>
                        <Font name="Papyrus" size="48.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="12.0">
                    <Label text="Winner:" style="-fx-text-fill: #FFF3E0; -fx-font-size: 22; -fx-font-weight: bold;" />
                    <Label fx:id="winnerLabel" text="---"
                           style="-fx-text-fill: #FFD700; -fx-font-size: 28; -fx-font-weight: bold;" />
                </HBox>

                <ScrollPane fitToWidth="true" prefHeight="400.0" VBox.vgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <VBox fx:id="playersList" alignment="TOP_CENTER" spacing="8.0" />
                </ScrollPane>

                <HBox alignment="CENTER" spacing="25.0">
                    <Button fx:id="buttonHistory" mnemonicParsing="false"
                            styleClass="button-menu-fire" text="Intergalactic Ranking"
                            onAction="#handleHistory" />
                    <Button fx:id="buttonNewGame" mnemonicParsing="false"
                            styleClass="button-menu-fire" text="New Game"
                            onAction="#handleNewGame" />
                    <Button fx:id="buttonMenu" mnemonicParsing="false"
                            styleClass="button-menu-fire" text="Back to Menu"
                            onAction="#handleMenu" />
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
